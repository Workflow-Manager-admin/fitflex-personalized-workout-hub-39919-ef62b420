# Example .env file for FitFlex workout_backend (Express API)

# Backend service configuration
PORT=5000

# Set to "mock" to use in-memory DB for dev, or provide a real DB URI (e.g., mongo/postgres/sqlite)
DB_URL=mock

# Secret for signing JWT tokens (replace in production!)
JWT_SECRET=changeme_very_secret

# Comma-separated list or single origin 
CORS_ORIGIN=http://localhost:3000

# Add any other environment variables as needed (see README.md for reference)

